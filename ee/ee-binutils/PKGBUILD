pkgname=ee-binutils
pkgver=2_44
pkgrel=1
pkgdesc=""
arch=("any")
options=(!strip libtool staticlibs)
url="https://github.com/bminor/binutils-gdb"
source=("${url}/archive/refs/tags/binutils-${pkgver}.tar.gz")

prepare() {
	mkdir -p build-binutils
	cd build-binutils
	
	target=mips64r5900el-ps2-elf
	sysroot="${PS2DEV}/ee/${target}"

	../binutils-gdb-binutils-$pkgver/configure --target=$target --prefix="${PS2DEV}/ee" --with-sysroot="${sysroot}" --disable-separate-code --disable-sim --disable-gdb --disable-nls --with-python=no
}

build() {
	cd build-binutils
	make
}

package() {
	cd build-binutils
	make DESTDIR="$pkgdir" install-strip
	rm -rf "$pkgdir"/${PS2DEV}/ee/share
}

sha256sums=("4960d1fb6d367c3c828f6e674b39c347f9fc824a24079382f68377476cb8b475")
